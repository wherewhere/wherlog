<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>wherewhere</Authors>
    <Copyright>Copyright © 2017 - 2026 wherewhere. All Rights Reserved.</Copyright>
    <Description>魔法薇ㄦ的书馆网页客户端</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/wherewhere/wherlog</RepositoryUrl>
    <VersionPrefix>0.0.1</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <CompressionEnabled>false</CompressionEnabled>
    <Language>zh-CN</Language>
    <LangVersion>latest</LangVersion>
    <RunAOTCompilation>true</RunAOTCompilation>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <TargetFramework>net11.0-browser</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.5" IsImplicitlyDefined="true" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <DownloadItem Include="https://github.com/haldai/org-slides/raw/refs/heads/master/style/fonts/DinkieBitmap-9px.woff2">
      <LocalFile>wwwroot\lib\org-slides\style\fonts\DinkieBitmap-9px.woff2</LocalFile>
    </DownloadItem>
  </ItemGroup>

  <Target Name="DownloadDependency" BeforeTargets="PreBuildEvent">
    <ItemGroup>
      <MissingDownloadItem Include="@(DownloadItem)" Condition="!Exists('%(LocalFile)')">
        <DestinationFolder>$([System.IO.Path]::GetDirectoryName('%(LocalFile)'))</DestinationFolder>
        <DestinationFileName>$([System.IO.Path]::GetFileName('%(LocalFile)'))</DestinationFileName>
      </MissingDownloadItem>
    </ItemGroup>
    <DownloadFile
      SourceUrl="%(MissingDownloadItem.Identity)"
      DestinationFolder="%(MissingDownloadItem.DestinationFolder)"
      DestinationFileName="%(MissingDownloadItem.DestinationFileName)"
      Condition="'@(MissingDownloadItem)' != ''" />
  </Target>

</Project>
